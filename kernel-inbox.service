# Template: generate with python3 scripts/install-service.py
[Unit]
Description=Kernel Inbox local mailing-list reader
After=network.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PYTHON@ server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
